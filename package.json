{
  "name": "technoart",
  "version": "0.1.0",
  "description": "A constrained CSS utility library",
  "main": "dist/technoart.css",
  "scripts": {
    "build": "sass index.scss dist/technoart.css --style=compressed --no-source-map",
    "build:dev": "sass index.scss dist/technoart.css --style=expanded",
    "dev": "sass --watch index.scss:dist/technoart.css"
  },
  "keywords": ["css", "utility", "design-system", "scss"],
  "license": "MIT",
  "devDependencies": {
    "sass": "^1.70.0"
  }
}
